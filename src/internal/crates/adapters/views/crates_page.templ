package views

import (
	"fmt"
	"github.com/alecdray/wax/src/internal/core/templates"
	"github.com/alecdray/wax/src/internal/crates"
)

// CratesListOOBFrag renders the crates list region as an OOB swap targeting
// #crates-list. Used after CreateCrate to refresh the list in-place.
templ CratesListOOBFrag(crateList []crates.CrateDTO) {
	<div id="crates-list" class="flex flex-col gap-2 px-4" data-testid="crates-list" hx-swap-oob="true">
		if len(crateList) == 0 {
			<p class="text-sm text-muted py-8 text-center" data-testid="crates-empty-state">No crates yet</p>
		} else {
			for _, crate := range crateList {
				<a
					href={ templ.URL(fmt.Sprintf("/app/crates/%s", crate.ID)) }
					class="card bg-base-200 p-4 flex flex-row items-center justify-between hover:bg-base-300 transition-colors"
					data-testid="crate-card"
				>
					<span class="font-medium">{ crate.Name }</span>
					<span class="text-sm text-muted">{ fmt.Sprintf("%d albums", crate.AlbumCount) }</span>
				</a>
			}
		}
	</div>
}

templ CratesPage(crateList []crates.CrateDTO) {
	@templates.PageLayoutComponent(templates.PageLayoutProps{
		Title:     templates.CreatePageTitle("Crates"),
		ActiveNav: "crates",
	}) {
		<div data-testid="crates-page" class="w-full flex flex-col pb-16">
			<div class="flex items-center justify-between px-4 py-4">
				<h1 class="text-xl font-bold">Crates</h1>
				<button
					class="btn btn-sm btn-primary"
					hx-get="/app/crates/new-modal"
					hx-swap="none"
					data-testid="new-crate-button"
				>
					New Crate
				</button>
			</div>
			<div id="crates-list" class="flex flex-col gap-2 px-4" data-testid="crates-list">
				if len(crateList) == 0 {
					<p class="text-sm text-muted py-8 text-center" data-testid="crates-empty-state">No crates yet</p>
				} else {
					for _, crate := range crateList {
						<a
							href={ templ.URL(fmt.Sprintf("/app/crates/%s", crate.ID)) }
							class="card bg-base-200 p-4 flex flex-row items-center justify-between hover:bg-base-300 transition-colors"
							data-testid="crate-card"
						>
							<span class="font-medium">{ crate.Name }</span>
							<span class="text-sm text-muted">{ fmt.Sprintf("%d albums", crate.AlbumCount) }</span>
						</a>
					}
				}
			</div>
		</div>
	}
}
