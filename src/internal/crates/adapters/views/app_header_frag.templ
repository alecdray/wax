package views

// cratesAppHeader is the sticky top bar shown on every crates page, matching
// the library/radar header pattern: wordmark left, caller-supplied actions right.
templ cratesAppHeader() {
	<header data-testid="crates-app-header" class="bg-base-100 border-b border-base-300 h-11 w-full flex-shrink-0 sticky top-0 z-10">
		<div class="h-full flex items-center justify-between px-4">
			<a href="/" class="text-lg text-primary font-brand" data-testid="crates-app-header-wordmark">wax</a>
			{ children... }
		</div>
	</header>
}
