package templates

import "fmt"

const globalModalContainerId = "global-modal-container"

templ ModalContainer(isSwap bool) {
	<div
		id={ globalModalContainerId }
		data-testid="modal-container"
		if isSwap {
			hx-swap-oob="true"
		}
	>
		{ children... }
	</div>
}

type ModalProps struct {
	TestID        string
	HeaderActions templ.Component
	ModalContent  templ.Component
	ModalActions  templ.Component
}

func modalTestID(id string) string {
	if id != "" {
		return id
	}
	return "modal"
}

templ Modal(id string, props ModalProps) {
	@ModalContainer(true) {
		<dialog id={ FormatCallableID(id) } data-testid={ modalTestID(props.TestID) } class="modal modal-bottom sm:modal-middle" open>
			<div class="modal-box flex flex-col p-0 sm:max-h-[95vh]">
				<div class="sticky top-0 z-10 flex items-center px-3 pt-3 pb-2 bg-base-100">
					<div class="flex-1">
						if props.HeaderActions != nil {
							@props.HeaderActions
						}
					</div>
					<form method="dialog">
						<button class="btn btn-sm btn-ghost btn-square" aria-label="Close">
							@Icon(IconProps{Name: "x-lg"})
						</button>
					</form>
				</div>
				<div class="flex flex-col px-3 pb-3">
					if props.ModalContent != nil {
						@props.ModalContent
					}
					if props.ModalActions != nil {
						<div class="modal-action">
							<form method="dialog">
								@props.ModalActions
							</form>
						</div>
					}
				</div>
				<div
					id={ fmt.Sprintf("%s-script", id) }
					class="hidden"
				></div>
			</div>
		</dialog>
	}
}

// StaticModal renders a pre-loaded dialog shown via showModal(). Unlike Modal,
// it is not HTMX-loaded or OOB-swapped — it lives in the DOM and is opened by
// the trigger. Pass content via the children slot.
templ StaticModal(id string, props ModalProps) {
	<dialog id={ id } data-testid={ modalTestID(props.TestID) } class="modal modal-bottom sm:modal-middle">
		<div class="modal-box flex flex-col p-0 sm:max-h-[95vh]">
			<div class="sticky top-0 z-10 flex items-center px-3 pt-3 pb-2 bg-base-100">
				<div class="flex-1">
					if props.HeaderActions != nil {
						@props.HeaderActions
					}
				</div>
				<form method="dialog">
					<button class="btn btn-sm btn-ghost btn-square" aria-label="Close">
						@Icon(IconProps{Name: "x-lg"})
					</button>
				</form>
			</div>
			<div class="flex flex-col px-3 pb-3">
				{ children... }
			</div>
		</div>
		<form method="dialog" class="modal-backdrop"><button>close</button></form>
	</dialog>
}

templ ForceCloseModal(id string) {
	<div
		id={ fmt.Sprintf("%s-script", id) }
		data-testid="force-close-modal"
		class="hidden"
		hx-on:htmx:load={ templ.JSFuncCall(fmt.Sprintf("%s.close", FormatCallableID(id))) }
		hx-swap-oob="true"
	></div>
}
