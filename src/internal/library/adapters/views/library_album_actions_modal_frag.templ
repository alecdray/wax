package views

import (
	"fmt"
	"github.com/alecdray/wax/src/internal/core/templates"
	"github.com/alecdray/wax/src/internal/library"
)

const LibraryAlbumActionsModalID = "library-album-actions-modal"

templ LibraryAlbumActionsModalFrag(album library.AlbumDTO) {
	@templates.Modal(LibraryAlbumActionsModalID, templates.ModalProps{
		ModalContent: libraryAlbumActionsModalContent(album),
	})
}

templ libraryAlbumActionsModalContent(album library.AlbumDTO) {
	<div data-testid="library-album-actions-modal-content" class="flex flex-col gap-4">
		<div class="flex items-center gap-3 min-w-0">
			if album.ImageURL != "" {
				<div class="avatar">
					<div class="mask mask-squircle size-24 flex-shrink-0">
						<img src={ album.ImageURL } alt={ album.Title }/>
					</div>
				</div>
			} else {
				<div class="avatar avatar-placeholder">
					<div class="mask mask-squircle size-24 flex-shrink-0 bg-base-300"></div>
				</div>
			}
			<div class="min-w-0">
				<h3 class="font-semibold text-lg truncate">{ album.Title }</h3>
				if len(album.Artists) > 0 {
					<div class="text-sm text-muted truncate">
						for i, artist := range album.Artists {
							if i > 0 {
								<span>, </span>
							}
							{ artist.Name }
						}
					</div>
				}
			</div>
		</div>
		<div class="flex flex-col gap-2">
			<a
				href={ templ.URL(fmt.Sprintf("https://open.spotify.com/album/%s", album.SpotifyID)) }
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-sm btn-soft"
				data-testid="library-album-actions-open-spotify"
			>
				Open in Spotify
				@templates.Icon(templates.IconProps{Name: "box-arrow-up-right"})
			</a>
			<a
				href={ templ.URL(fmt.Sprintf("/app/library/albums/%s", album.ID)) }
				class="btn btn-sm btn-soft"
				data-testid="library-album-actions-open-details"
			>
				Open details
			</a>
			<button
				type="button"
				class="btn btn-sm btn-soft"
				hx-get={ fmt.Sprintf("/app/crates/picker?albumId=%s", album.ID) }
				hx-swap="none"
				data-testid="library-album-actions-add-to-crate"
			>Add to crate</button>
		</div>
	</div>
}

// libraryAlbumRowClick is the OnRowClick handler for library dashboard rows and
// carousel cards — clicking triggers an HTMX fetch of the album actions modal.
templ libraryAlbumRowClick(albumID string) {
	<button
		type="button"
		class="cursor-pointer text-left"
		hx-get={ fmt.Sprintf("/app/library/albums/%s/actions-modal", albumID) }
		hx-swap="none"
	>
		{ children... }
	</button>
}
