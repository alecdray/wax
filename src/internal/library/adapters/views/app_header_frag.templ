package views

import (
	"github.com/alecdray/wax/src/internal/core/templates"
	"github.com/alecdray/wax/src/internal/feed"
)

// FeedsToAppHeaderFeeds converts feed.FeedDTO slice to the plain-value type
// accepted by core/templates components. Used by both views and the HTTP handler.
func FeedsToAppHeaderFeeds(feeds []feed.FeedDTO) []templates.AppHeaderFeed {
	out := make([]templates.AppHeaderFeed, len(feeds))
	for i, f := range feeds {
		out[i] = templates.AppHeaderFeed{
			ID:       f.ID,
			Name:     string(f.Kind),
			Syncing:  f.LastSyncStatus.IsSyncing(),
			Failed:   f.LastSyncStatus.IsSyncFailed(),
			Unsynced: f.LastSyncStatus.IsUnsyned(),
			Stale:    f.IsSyncStale(),
			Synced:   f.LastSyncStatus.IsSynced(),
		}
	}
	return out
}

// LibraryAppHeaderFrag is the slim top app bar shown on every authenticated
// library page: the wax wordmark (brand identity) on the left and the feeds
// sync-status control on the right. Navigation lives in the bottom nav (ADR
// 0007); this header carries identity and at-a-glance feed status only.
//
// It also hosts the hidden album-surface listener, so peer-module album
// mutations refresh the affected surfaces in place on any library page.
templ LibraryAppHeaderFrag(feeds []feed.FeedDTO) {
	@templates.AppHeaderFrag(FeedsToAppHeaderFeeds(feeds)) {
		@AlbumSurfaceListenerFrag()
	}
}
